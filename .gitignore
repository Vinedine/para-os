# This repo deliberately ships CLAUDE.md files (the example vault's conventions
# are part of the product). Un-ignore them in case your global gitignore excludes CLAUDE.md.
!CLAUDE.md

# Personal notes beside the shared root CLAUDE.md.
/CLAUDE.local.md

# Maintainer skills and settings for working on this repo are shared from the root .claude/.
# Only what is named here: local settings, worktrees and anything else a session writes
# there stay out.
!/.claude/
/.claude/*
!/.claude/settings.json
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/release/

# The base vault bundles the skills in .claude/skills/ so one copy yields a working
# vault. Un-ignore that path in case your global gitignore excludes .claude/.
!base/.claude/
!base/.claude/**

# Add-ons ship their own rules and skills
!addons/**/.claude/
!addons/**/.claude/**

# The example vault ships .claude/settings.json and .claude/rules/ as product content too.
!examples/belfoot-vault/.claude/
!examples/belfoot-vault/.claude/**

# Its skills, however, are copied in by the user to try the demo (see examples/README.md)
# and stay untracked, so base/.claude/skills/ remains their single source.
examples/belfoot-vault/.claude/skills/

# Build artifacts from running the integration scripts in place.
__pycache__/
*.pyc
.pytest_cache/

# MCP server config holds live tokens.
.mcp.json
